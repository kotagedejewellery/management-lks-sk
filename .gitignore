# Environment and secrets
/.env
/.env.*
!/.env.example
/backend/.env
/backend/.env.*
!/backend/.env.example

# Dependencies
/node_modules/
/frontend/node_modules/
/backend/node_modules/
/backend/vendor/

# Laravel generated files
/backend/storage/app/private/lks-signatures/
/backend/public/build/
/backend/public/hot
/backend/public/storage
/backend/bootstrap/cache/*.php
!/backend/bootstrap/cache/.gitignore
/backend/storage/*.key
/backend/storage/pail/
/backend/storage/logs/*
!/backend/storage/logs/.gitignore
/backend/storage/framework/cache/*
!/backend/storage/framework/cache/.gitignore
/backend/storage/framework/sessions/*
!/backend/storage/framework/sessions/.gitignore
/backend/storage/framework/views/*
!/backend/storage/framework/views/.gitignore

# Test and diagnostic artifacts
/backend/.phpunit.cache/
/backend/.phpunit.result.cache
/backend/coverage/
*.log

# Package-manager diagnostics
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor and operating-system files
/.idea/
/.vscode/
/.fleet/
/.zed/
.DS_Store
Thumbs.db
